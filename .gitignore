__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.DS_Store
*.pptx
*.zip

# Node (dashboard/frontend)
node_modules/
dist/
*.local

# real dataset extracts used for local validation only -- never commit raw KITTI data
tracking/kitti_validation_data/

# raw LiDAR datasets + trained model artifacts (Member 1) -- never commit these
data/semantickitti/
data/nuscenes/
data/carla/
models/checkpoints/
models/runs/
*.pth
*.onnx

# security (Member 6) -- JWT secret + demo passwords resolve here at runtime,
# and dev TLS certs are generated here; neither should ever be committed
security/.env
security/certs/

# runtime audit trail (security/audit.py) -- generated log data, not source
security/audit.log

# ONNX/TensorRT export + benchmark outputs (security/export_onnx.py,
# build_tensorrt_engine.py, benchmark_*.py) -- built/measured artifacts,
# GPU-specific in the .engine case, never source
security/optimized/

# SROS2 keystore (security/generate_sros2_keystore.sh) -- contains real
# private keys (enclaves/*/key.pem, private/ca.key.pem); never commit a
# keystore, regenerate it locally instead
security/sros2_keystore/

# colcon build output (ros2_ws/) -- generated locally by every builder, never source
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
